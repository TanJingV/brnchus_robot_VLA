<mujoco model="robot3_with_cable_v11_tip_motors">
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002" iterations="50" tolerance="1e-4" integrator="RK4" gravity="0 0 -9.81" impratio="10"/>

  <extension>
    <plugin plugin="mujoco.elasticity.cable"/>
  </extension>

  <visual>
    <quality shadowsize='1024'/>
    <map znear='0.05'/>
    <headlight diffuse="0.6 0.6 0.6"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <default>
    <motor ctrllimited='true'/>
    <geom contype="2" conaffinity="2" group="0" margin="0.001" condim="6" density="100"/>
  </default>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="slid_base" file="slid_base.STL"/>
    <mesh name="slid_M" file="slid_M.STL"/>
    <mesh name="lian" file="lian.STL"/>
    <mesh name="qudong1" file="qudong1.STL"/>
    <mesh name="qudong2" file="qudong2.STL"/>

    <texture name="plane" type="2d" builtin="checker" rgb1=".1 .1 .1" rgb2=".9 .9 .9" width="512" height="512" mark="cross" markrgb=".8 .8 .8" />
    <material name="plane" reflectance="0.3" texture="plane" texrepeat="1 1" texuniform="true" />
  </asset>

  <worldbody>
    <geom name="floor" pos="0 0 0" size="0 0 .25" type="plane" material="plane" condim="3" />
    <light directional="true" ambient=".3 .3 .3" pos="30 30 30" dir="0 -.5 -1" diffuse=".5 .5 .5" specular=".5 .5 .5" />   

    <body pos="0.3138 0.015 2.054" name="box1">
        <freejoint />
        <geom type="box" size="0.1 0.1 0.1" mass="2" rgba="1 0 0 1" condim="3" contype="1" group="1"/>
    </body>

    <body name="base_link" pos="-0.5 0 1">
        <geom type="mesh" contype="2" conaffinity="2" group="2" rgba="0.792157 0.819608 0.933333 1" mesh="base_link"/>
        
        <body name="slid_base" pos="0 0 0">
          <inertial pos="0.03293 7.3319e-05 0.016441" quat="0.000144867 0.705902 0.000144374 0.708309" mass="0.419" diaginertia="0.0187072 0.018638 0.000128635"/>
          <joint name="slid_base" axis ="0 0 1"/>
          <geom type="mesh" contype="2" conaffinity="2" group="2" rgba="0.75294 0.75294 0.75294 1" mesh="slid_base"/>
          
          <body name="slid_M" pos="-0.2 0 0.0195">
            <inertial pos="0.012817 0.0243347 0.035479" quat="0.646657 0.297989 -0.319545 0.625243" mass="0.743603" diaginertia="0.0033383 0.00264726 0.0020156"/>
            <joint name="slid_M" type="slide" axis="1 0 0" range="0 0.577" armature="5" frictionloss="1000" damping="1000" />
            <geom type="mesh" contype="2" conaffinity="2" group="1" rgba="0.45294 0.45294 0.45294 1" mesh="slid_M"/>
            <geom pos="0.0988 0 0.074501" quat="1 0 0 0" type="mesh" contype="2" conaffinity="2" group="1" density="1" rgba="0.85294 0.85294 0.75294 1" mesh="qudong1"/>
            <geom pos="0.0988 0 0.074501" quat="1 0 0 0" type="mesh" contype="2" conaffinity="2" group="1" density="1" rgba="0.85294 0.85294 0.75294 1" mesh="qudong2"/>
            
            <body name="base_plate" pos="0.0988 0 0.0745">
              <geom type="cylinder" size="0.004 0.001" rgba=".5 .5 .5 1" euler="0 1.57 0" contype="1" />
              <site name="base_s1" pos="0  0.003 0"        size="0.001" rgba="1 0 0 1"/> 
              <site name="base_s2" pos="0  0.0015 0.002595" size="0.001" rgba="1 1 0 1"/> 
              <site name="base_s3" pos="0 -0.0015 0.002595" size="0.001" rgba="0 1 0 1"/> 
              <site name="base_s4" pos="0 -0.003 0"        size="0.001" rgba="0 1 1 1"/> 
              <site name="base_s5" pos="0 -0.0015 -0.002595" size="0.001" rgba="0 0 1 1"/> 
              <site name="base_s6" pos="0  0.0015 -0.002595" size="0.001" rgba="1 0 1 1"/>

              <body name="cable_stiff" pos="0 0 0">
                <composite prefix="cable_stiff" type="cable" curve="s" count="51 1 1" size="0.65" initial="none">
                  <plugin plugin="mujoco.elasticity.cable">
                    <config key="twist" value="1e7"/>    
                    <config key="bend" value="5e9"/>     
                    <config key="vmax" value="1"/>
                  </plugin>
                  <joint kind="main" damping="10" stiffness="200" armature="0.01"/>
                  <geom type="cylinder" size=".0036" rgba=".8  .2 .1 1" condim="3" contype="1" mass="0.0001" solref="0.001 1" solimp="0.99 0.99 0.01"/>
                </composite>
              </body>
              
              </body>
          </body>
      </body>
    </body>
    
    <body name="cable" pos="0.0488 0 1.094">
    <freejoint />
      <composite type="cable" curve="s" count="21 1 1" size="0.065" initial="none">
        <plugin plugin="mujoco.elasticity.cable">
          <config key="twist" value="5e6"/>
          <config key="bend" value="15e2"/>
          <config key="vmax" value=".1"/>
        </plugin>
        <joint kind="main" damping="0.3" stiffness="3" armature="0.01"/>
        <geom type="cylinder" size=".0035" rgba=".8 .2 .1 1" condim="3" contype="1" mass="0.001" solref="0.001 1" solimp="0.99 0.99 0.01"/>
      </composite>
    </body>

    <body name="slider" pos="0.1138 0 1.094">
      <joint type="free" name="slider_joint"/> 
      <geom size=".001" mass="1e-6" rgba="0 0 0 0" contype="0" conaffinity="0"/>
      
      <body name="end_6" pos="0 0 0">
        <geom name="end_6_mass_geom" type="sphere" size="1e-4" mass="1e-6" rgba="0 0 0 0" contype="0" conaffinity="0"/>
          <site name="s1" pos="0  0.003 0"        size="0.0005" rgba="1 0 0 1"/> 
          <site name="s2" pos="0  0.0015 0.002595" size="0.0005" rgba="1 1 0 1"/> 
          <site name="s3" pos="0 -0.0015 0.002595" size="0.0005" rgba="0 1 0 1"/> 
          <site name="s4" pos="0 -0.003 0"        size="0.0005" rgba="0 1 1 1"/> 
          <site name="s5" pos="0 -0.0015 -0.002595" size="0.0005" rgba="0 0 1 1"/> 
          <site name="s6" pos="0  0.0015 -0.002595" size="0.0005" rgba="1 0 1 1"/>
      </body>
    </body>

    <body name="front_object_table" pos="0 0 0" euler="0 0 0">
      <geom name="front_object_table" size="1.0 0.7 0.4" pos="0.5 0 0.4" type="box" />
      <inertial pos="0 0 0" mass="1" diaginertia="0 0 0" />

      <body name="camera" pos="0.8 0.0 1.2">
          <camera name="agentview" pos="0 0 0" xyaxes="0 1 0  -0.5 0 0.707" fovy="60" />
      </body>
      <body name="camera2" pos="0.5 0.0 1.8">
          <camera name="topview" pos="0 0 0" xyaxes="0 -1 0 1 0 0" fovy="90" />
      </body>
      <body name="camera3" pos="0.3 -0.7 1.3">
          <camera name="sideview" pos="0 0 0" xyaxes="1 0 0 0 0 1" fovy="90" />
      </body>
    </body>
  </worldbody>

  <equality>
    <weld name="right_boundary" body1="B_last" body2="slider" anchor="0 0 0" solimp="0.99 1.0 0.0001" solref="0.0001 1.0"/>  
    <weld name="right_boundary1" body1="B_first" body2="cable_stiffB_last" anchor="0 0 0" solimp="0.99 1.0 0.0001" solref="0.0001 1.0"/> 
    <weld name="weld_end6" body1="end_6" body2="B_last" anchor="0 0 0" solimp="0.99 1.0 0.0001" solref="0.0001 1.0"/>
  </equality>

  <contact>
    <exclude body1="B_last" body2="slider" />
  </contact>

  <tendon>
    <spatial name="tendon1" width="0.0005" rgba="1 0 0 1" limited="true" range="0 0.8">
        <site site="base_s1"/>
        <site site="s1"/>
    </spatial>
    <spatial name="tendon2" width="0.0005" rgba="1 1 0 1" limited="true" range="0 0.8">
        <site site="base_s2"/>
        <site site="s2"/>
    </spatial>
    <spatial name="tendon3" width="0.0005" rgba="0 1 0 1" limited="true" range="0 0.8">
        <site site="base_s3"/>
        <site site="s3"/>
    </spatial>
    <spatial name="tendon4" width="0.0005" rgba="0 1 1 1" limited="true" range="0 0.8">
        <site site="base_s4"/>
        <site site="s4"/>
    </spatial>
    <spatial name="tendon5" width="0.0005" rgba="0 0 1 1" limited="true" range="0 0.8">
        <site site="base_s5"/>
        <site site="s5"/>
    </spatial>
    <spatial name="tendon6" width="0.0005" rgba="1 0 1 1" limited="true" range="0 0.8">
        <site site="base_s6"/>
        <site site="s6"/>
    </spatial>
  </tendon>

  <actuator>
    <position name="act_slid_M" joint="slid_M" kp="100000" ctrlrange="0 0.577"/>
    <motor name="up" site="S_last" gear="0.03 0 0 0 -0.03 0" ctrlrange="-100 100"/>
    <motor name="right" site="S_last" gear="0.03 0 0 0 0 -0.03" ctrlrange="-100 100"/>
    <position name="act_t1" tendon="tendon1" kp="200" ctrlrange="0 0.718"/>
    <position name="act_t2" tendon="tendon2" kp="200" ctrlrange="0 0.718"/>
    <position name="act_t3" tendon="tendon3" kp="200" ctrlrange="0 0.718"/>
    <position name="act_t4" tendon="tendon4" kp="200" ctrlrange="0 0.718"/>
    <position name="act_t5" tendon="tendon5" kp="200" ctrlrange="0 0.718"/>
    <position name="act_t6" tendon="tendon6" kp="200" ctrlrange="0 0.718"/>

    <motor name="force_s1" site="s1" gear="1 0 0 0 0 0" ctrlrange="-10 10"/>
    <motor name="force_s2" site="s2" gear="1 0 0 0 0 0" ctrlrange="-10 10"/>
    <motor name="force_s3" site="s3" gear="1 0 0 0 0 0" ctrlrange="-10 10"/>
    <motor name="force_s4" site="s4" gear="1 0 0 0 0 0" ctrlrange="-10 10"/>
    <motor name="force_s5" site="s5" gear="1 0 0 0 0 0" ctrlrange="-10 10"/>
    <motor name="force_s6" site="s6" gear="1 0 0 0 0 0" ctrlrange="-10 10"/>
  </actuator>

  <keyframe>
    <key name="home" ctrl="0 0 0 0.718 0.718 0.718 0.718 0.718 0.718 0 0 0 0 0 0"/>
  </keyframe>
  <include file="Bronchial_model.xml"/>

</mujoco>